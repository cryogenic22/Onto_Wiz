# Normalize line endings: text files are LF in the repo, checked out native.
* text=auto eol=lf

# Shell scripts must stay LF (they run on Linux/Railway).
*.sh text eol=lf

# Windows batch stays CRLF.
*.bat text eol=crlf

# Treat these as binary (no eol munging, no diff noise).
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
