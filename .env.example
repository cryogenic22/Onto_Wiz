# Copy to .env and fill in real values. NEVER commit the real .env.
# In production these are set as Railway service variables, not from a file.

# Anthropic API key — used by the agent-lift benchmark and the live consult path.
ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection string. Railway injects this automatically when a
# Postgres plugin is attached to the service (Unit 5 / Unit 6).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Where compiled packs are read from at serve time (defaults to ./packs).
# ONTOWIZ_PACKS_ROOT=packs

# Server-side gate: allow REVIEW/VERIFIED (dev) context over the API.
# Leave unset/false in production.
# ONTOWIZ_ALLOW_DEV_CONTEXT=false
