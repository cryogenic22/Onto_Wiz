BODY:trigger_signals=signal_name=has_channel_change; threshold=Commercial:ChannelShift; data_source=tag_match, signal_name=has_volume_anomaly; threshold=Commercial:VolumeDrop | Commercial:ShareLoss; data_source=tag_match; trigger_context=Dispensing pattern shift from one channel to another affecting volume measurement.; decision_logic=has_channel_change AND has_volume_anomaly => Channel shift detected. Apparent volume decline may reflect dispensing migration, not true demand loss.; judgment_type=empirical; anti_patterns=wrong_conclusion=A genuine loss of patient demand; why_wrong=A dispensing/channel migration is a measurement artifact in the tracked source — apparent volume loss, not true demand erosion.; unless_evidence=; typical_outcome=Channel shift detected. Apparent volume decline may reflect dispensing migration, not true demand loss.; sme_confidence=0.5; scope=priority=55; valid_for_days=180
