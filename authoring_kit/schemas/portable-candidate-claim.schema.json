{
  "$defs": {
    "PortableCandidateArtifactBinding": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^(?![Cc][Oo][Nn]$|[Pp][Rr][Nn]$|[Aa][Uu][Xx]$|[Nn][Uu][Ll]$|[Cc][Oo][Mm][1-9]$|[Ll][Pp][Tt][1-9]$)[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "payload_digest"
      ],
      "title": "PortableCandidateArtifactBinding",
      "type": "object"
    },
    "PortableEvidenceBinding": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "pattern": "^(?![Cc][Oo][Nn]$|[Pp][Rr][Nn]$|[Aa][Uu][Xx]$|[Nn][Uu][Ll]$|[Cc][Oo][Mm][1-9]$|[Ll][Pp][Tt][1-9]$)[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_item_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Item Digest",
          "type": "string"
        },
        "source_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Checksum",
          "type": "string"
        },
        "source_id": {
          "pattern": "^(?![Cc][Oo][Nn]$|[Pp][Rr][Nn]$|[Aa][Uu][Xx]$|[Nn][Uu][Ll]$|[Cc][Oo][Mm][1-9]$|[Ll][Pp][Tt][1-9]$)[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "evidence_item_digest",
        "source_id",
        "source_checksum"
      ],
      "title": "PortableEvidenceBinding",
      "type": "object"
    },
    "PortableSourceBinding": {
      "additionalProperties": false,
      "properties": {
        "registered_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Registered Checksum",
          "type": "string"
        },
        "source_id": {
          "pattern": "^(?![Cc][Oo][Nn]$|[Pp][Rr][Nn]$|[Aa][Uu][Xx]$|[Nn][Uu][Ll]$|[Cc][Oo][Mm][1-9]$|[Ll][Pp][Tt][1-9]$)[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_record_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Record Digest",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "registered_checksum",
        "source_record_digest"
      ],
      "title": "PortableSourceBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_artifact_bindings": {
      "items": {
        "$ref": "#/$defs/PortableCandidateArtifactBinding"
      },
      "minItems": 1,
      "title": "Candidate Artifact Bindings",
      "type": "array"
    },
    "claim": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Claim",
      "type": "string"
    },
    "claim_record_id": {
      "pattern": "^(?![Cc][Oo][Nn]$|[Pp][Rr][Nn]$|[Aa][Uu][Xx]$|[Nn][Uu][Ll]$|[Cc][Oo][Mm][1-9]$|[Ll][Pp][Tt][1-9]$)[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "title": "Claim Record Id",
      "type": "string"
    },
    "evidence_bindings": {
      "items": {
        "$ref": "#/$defs/PortableEvidenceBinding"
      },
      "minItems": 1,
      "title": "Evidence Bindings",
      "type": "array"
    },
    "format": {
      "const": "ontowiz-candidate-claim-record",
      "title": "Format",
      "type": "string"
    },
    "format_version": {
      "const": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "pack_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Pack Manifest Digest",
      "type": "string"
    },
    "record_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Record Digest",
      "type": "string"
    },
    "session_id": {
      "pattern": "^(?![Cc][Oo][Nn]$|[Pp][Rr][Nn]$|[Aa][Uu][Xx]$|[Nn][Uu][Ll]$|[Cc][Oo][Mm][1-9]$|[Ll][Pp][Tt][1-9]$)[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "session_sequence": {
      "minimum": 0,
      "title": "Session Sequence",
      "type": "integer"
    },
    "source_bindings": {
      "items": {
        "$ref": "#/$defs/PortableSourceBinding"
      },
      "minItems": 1,
      "title": "Source Bindings",
      "type": "array"
    },
    "status": {
      "const": "candidate",
      "title": "Status",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^(?!con$|prn$|aux$|nul$|com[1-9]$|lpt[1-9]$)[a-z0-9][a-z0-9_-]{0,62}$",
      "title": "Workspace Id",
      "type": "string"
    },
    "workspace_revision": {
      "minimum": 0,
      "title": "Workspace Revision",
      "type": "integer"
    }
  },
  "required": [
    "workspace_id",
    "workspace_revision",
    "session_id",
    "session_sequence",
    "status",
    "record_digest",
    "source_bindings",
    "evidence_bindings",
    "candidate_artifact_bindings",
    "pack_manifest_digest",
    "format",
    "format_version",
    "claim_record_id",
    "claim"
  ],
  "title": "PortableCandidateClaim",
  "type": "object"
}
