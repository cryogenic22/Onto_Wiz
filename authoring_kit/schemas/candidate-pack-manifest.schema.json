{
  "$defs": {
    "ArtifactDigest": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^(?![Cc][Oo][Nn]$|[Pp][Rr][Nn]$|[Aa][Uu][Xx]$|[Nn][Uu][Ll]$|[Cc][Oo][Mm][1-9]$|[Ll][Pp][Tt][1-9]$)[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "digest"
      ],
      "title": "ArtifactDigest",
      "type": "object"
    },
    "PublicSuite": {
      "enum": [
        "dev",
        "regression",
        "challenge"
      ],
      "title": "PublicSuite",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_digests": {
      "items": {
        "$ref": "#/$defs/ArtifactDigest"
      },
      "title": "Artifact Digests",
      "type": "array"
    },
    "contains_protected_evaluations": {
      "const": false,
      "title": "Contains Protected Evaluations",
      "type": "boolean"
    },
    "format": {
      "const": "ontowiz-candidate-pack",
      "title": "Format",
      "type": "string"
    },
    "format_version": {
      "const": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "pack_id": {
      "pattern": "^(?!con$|prn$|aux$|nul$|com[1-9]$|lpt[1-9]$)[a-z0-9][a-z0-9_-]{0,62}$",
      "title": "Pack Id",
      "type": "string"
    },
    "pack_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
      "title": "Pack Version",
      "type": "string"
    },
    "package_kind": {
      "const": "candidate",
      "title": "Package Kind",
      "type": "string"
    },
    "production_eligible": {
      "const": false,
      "title": "Production Eligible",
      "type": "boolean"
    },
    "public_evaluation_suites": {
      "items": {
        "$ref": "#/$defs/PublicSuite"
      },
      "title": "Public Evaluation Suites",
      "type": "array"
    },
    "releasable": {
      "const": false,
      "title": "Releasable",
      "type": "boolean"
    },
    "schema_revision": {
      "const": 1,
      "title": "Schema Revision",
      "type": "integer"
    },
    "schema_target": {
      "const": "ontowiz-spec/vNext-min",
      "title": "Schema Target",
      "type": "string"
    }
  },
  "required": [
    "format",
    "format_version",
    "package_kind",
    "schema_target",
    "schema_revision",
    "pack_id",
    "pack_version",
    "production_eligible",
    "releasable",
    "contains_protected_evaluations",
    "artifact_digests",
    "public_evaluation_suites"
  ],
  "title": "CandidatePackManifest",
  "type": "object"
}
