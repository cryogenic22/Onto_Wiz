{
  "$defs": {
    "Confidentiality": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "Confidentiality",
      "type": "string"
    },
    "SourceStatus": {
      "enum": [
        "current",
        "superseded",
        "withdrawn"
      ],
      "title": "SourceStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "draft"
          }
        }
      },
      "then": {
        "properties": {
          "lifecycle_history": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "review"
          }
        }
      },
      "then": {
        "properties": {
          "lifecycle_history": {
            "maxItems": 1,
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "withdrawn"
          }
        }
      },
      "then": {
        "properties": {
          "withdrawn_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "withdrawn_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "contains_personal_data": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "consent_basis": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          }
        },
        "required": [
          "consent_basis"
        ]
      }
    }
  ],
  "properties": {
    "checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Checksum",
      "type": "string"
    },
    "client_boundary": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Client Boundary",
      "type": "string"
    },
    "confidentiality": {
      "$ref": "#/$defs/Confidentiality"
    },
    "consent_basis": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consent Basis"
    },
    "contains_personal_data": {
      "title": "Contains Personal Data",
      "type": "boolean"
    },
    "fresh_until": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Fresh Until"
    },
    "id": {
      "pattern": "^(?![Cc][Oo][Nn]$|[Pp][Rr][Nn]$|[Aa][Uu][Xx]$|[Nn][Uu][Ll]$|[Cc][Oo][Mm][1-9]$|[Ll][Pp][Tt][1-9]$)[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "owner_role": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Owner Role",
      "type": "string"
    },
    "permitted_uses": {
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "minItems": 1,
      "title": "Permitted Uses",
      "type": "array"
    },
    "personal_data_transfer_allowed": {
      "default": false,
      "title": "Personal Data Transfer Allowed",
      "type": "boolean"
    },
    "quotation_allowed": {
      "title": "Quotation Allowed",
      "type": "boolean"
    },
    "raw_transfer_allowed": {
      "title": "Raw Transfer Allowed",
      "type": "boolean"
    },
    "redistribution_allowed": {
      "title": "Redistribution Allowed",
      "type": "boolean"
    },
    "retention_until": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Retention Until"
    },
    "scope": {
      "items": {
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "minItems": 1,
      "title": "Scope",
      "type": "array"
    },
    "source_date": {
      "format": "date",
      "title": "Source Date",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/SourceStatus",
      "default": "current"
    },
    "title": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Title",
      "type": "string"
    },
    "withdrawn_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Withdrawn At"
    }
  },
  "required": [
    "id",
    "title",
    "owner_role",
    "checksum",
    "source_date",
    "fresh_until",
    "scope",
    "client_boundary",
    "confidentiality",
    "permitted_uses",
    "quotation_allowed",
    "redistribution_allowed",
    "raw_transfer_allowed",
    "retention_until",
    "contains_personal_data"
  ],
  "title": "SourceRecord",
  "type": "object"
}
